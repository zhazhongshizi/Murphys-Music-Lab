{
  "protocolVersion": 2,
  "maxLineBytes": 1048576,
  "maxJsonDepth": 128,
  "maxCredentialBytes": 65536,
  "versionEncoding": "json-integer-token",
  "firstMethod": "system.handshake",
  "requestIdPattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
  "providerNames": {
    "netease": "netease-provider",
    "bilibili": "bilibili-provider"
  },
  "capabilities": {
    "netease": {
      "loginMethods": [
        "qr"
      ],
      "searchKinds": [
        "songs",
        "playlists"
      ],
      "libraryKinds": [
        "created",
        "favorite",
        "likes"
      ],
      "writeActions": [
        "song.like",
        "song.unlike",
        "playlist.subscribe",
        "playlist.unsubscribe",
        "playlist.addTracks",
        "playlist.removeTracks"
      ],
      "lyrics": true,
      "qualities": [
        "auto",
        "flac",
        "320k",
        "128k"
      ]
    },
    "bilibili": {
      "loginMethods": [
        "qr"
      ],
      "searchKinds": [
        "videos"
      ],
      "libraryKinds": [
        "created",
        "favorite"
      ],
      "writeActions": [
        "favorite.addVideos",
        "favorite.removeVideos"
      ],
      "lyrics": false,
      "qualities": [
        "auto",
        "aac"
      ]
    }
  },
  "methods": {
    "system.handshake": {
      "params": "system_handshakeParams",
      "result": "handshake",
      "providers": [
        "netease",
        "bilibili"
      ],
      "access": "handshake",
      "semantics": "neverReplay"
    },
    "system.ping": {
      "params": "system_pingParams",
      "result": "ping",
      "providers": [
        "netease",
        "bilibili"
      ],
      "access": "liveProcess",
      "semantics": "readOnly"
    },
    "auth.qr.start": {
      "params": "auth_qr_startParams",
      "result": "qrImage",
      "providers": [
        "netease",
        "bilibili"
      ],
      "access": "authenticating",
      "semantics": "neverReplay"
    },
    "auth.qr.poll": {
      "params": "auth_qr_pollParams",
      "result": "qrState",
      "providers": [
        "netease",
        "bilibili"
      ],
      "access": "authenticating",
      "semantics": "neverReplay"
    },
    "auth.qr.cancel": {
      "params": "auth_qr_cancelParams",
      "result": "cancel",
      "providers": [
        "netease",
        "bilibili"
      ],
      "access": "authenticating",
      "semantics": "neverReplay"
    },
    "auth.credential.restore": {
      "params": "auth_credential_restoreParams",
      "result": "authResult",
      "providers": [
        "netease",
        "bilibili"
      ],
      "access": "restoring",
      "semantics": "neverReplay"
    },
    "auth.credential.check": {
      "params": "auth_credential_checkParams",
      "result": "checkResult",
      "providers": [
        "netease",
        "bilibili"
      ],
      "access": "authenticated",
      "semantics": "readOnly"
    },
    "auth.credential.refresh": {
      "params": "auth_credential_refreshParams",
      "result": "refreshResult",
      "providers": [
        "netease"
      ],
      "access": "authenticated",
      "semantics": "neverReplay"
    },
    "auth.logout": {
      "params": "auth_logoutParams",
      "result": "logout",
      "providers": [
        "netease",
        "bilibili"
      ],
      "access": "signingOut",
      "semantics": "neverReplay"
    },
    "search.songs": {
      "params": "search_songsParams",
      "result": "trackPage",
      "providers": [
